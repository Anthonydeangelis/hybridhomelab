# Copy to ignored terraform.tfvars and replace all placeholders.
subscription_id      = "00000000-0000-0000-0000-000000000000"
location             = "eastus2"
project_name         = "hybridlab"
environment          = "lab"
admin_cidr           = "203.0.113.8/32"
ssh_public_key       = "ssh-ed25519 AAAA... replace-with-your-public-key"

# Globally unique names for resources Terraform creates during the first apply.
storage_account_name = "hybridlabstorage1234"
key_vault_name       = "hybridlab-kv-1234"
web_dns_label       = "hybridhomelabweb"
