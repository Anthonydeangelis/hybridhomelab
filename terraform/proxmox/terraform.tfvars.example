# This file is safe to commit. Copy it to terraform.tfvars and replace every value.
# Do not commit terraform.tfvars or your API token.

proxmox_endpoint    = "https://192.168.1.50:8006/api2/json"
proxmox_api_token   = "terraform@pve!homelab=REPLACE_WITH_TOKEN_SECRET"
proxmox_insecure    = true
node_name           = "pve"
datastore_id        = "local-lvm"
bridge              = "vmbr0"
windows_template_id = 9001
ubuntu_template_id  = 9000
linux_username      = "labadmin"
ssh_public_key      = "ssh-ed25519 AAAA...replace-with-your-public-key"

# Check that these VM IDs are unused before applying.
fs01_vmid = 201
ubuntu_servers = {
  WEB01   = { vmid = 202, cores = 2, memory_mb = 2048, disk_gb = 40, address = "dhcp" }
  WAZUH01 = { vmid = 203, cores = 2, memory_mb = 4096, disk_gb = 80, address = "dhcp" }
}
