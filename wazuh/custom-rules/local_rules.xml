<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,windows,active_directory,">

  <rule id="100101" level="9">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>New AD user account created: $(win.eventdata.targetUserName)</description>
    <group>dc01,active_directory,user_management,</group>
  </rule>

  <rule id="100100" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID" type="pcre2">^(4728|4729|4732|4733|4756|4757)$</field>
    <description>AD group membership changed</description>
    <group>dc01,active_directory,privilege_change,</group>
  </rule>

</group>

<group name="local,windows,entra_connect,">

  <!-- SYNC01 - Entra Connect / ADSync service stopped -->
  <rule id="100110" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^7036$</field>
    <match type="pcre2">(?i)(ADSync|Microsoft Azure AD Sync|Microsoft Entra Connect).*(stopped|stop)</match>
    <description>Entra Connect sync service stopped on $(agent.name)</description>
    <group>sync01,entra_connect,service_monitoring,</group>
  </rule>

</group>

<group name="local,windows,file_server,">

  <!-- FS01 - Multiple failed Windows logons -->
  <rule id="100120" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <description>Multiple failed Windows logons detected on $(agent.name)</description>
    <group>fs01,authentication_failed,bruteforce,</group>
  </rule>

</group>

<group name="local,linux,web_server,">

  <!-- WEB01 - Sudo command used -->
  <rule id="100200" level="7">
    <if_group>sudo</if_group>
    <description>Sudo command used on $(agent.name)</description>
    <group>web01,linux_privilege,sudo,</group>
  </rule>

</group>
